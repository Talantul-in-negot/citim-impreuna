{
  "name": "citim-impreuna",
  "version": "1.0.0",
  "private": true,
  "description": "Completează cuvintele lipsă din versete biblice și adună puncte.",
  "scripts": {
    "validate:verses": "node validate.js && node validate2sam.js",
    "check:assets": "node scripts/check-asset-versions.js",
    "build:answer-key": "node scripts/build-answer-key.js",
    "build:verses": "node scripts/build-window.js",
    "test": "npm run validate:verses && npm run check:assets && npm run check:names && npm run check:migrations && npm run check:progress && npm run check:reading-day && npm run check:chapter-pages",
    "check:chapter-pages": "node scripts/check-chapter-pages.js",
    "check:reading-day": "node scripts/check-reading-day.js",
    "check:progress": "node scripts/check-progress-resume.js",
    "check:migrations": "node scripts/build-apply-all.js --check && node scripts/check-cycle-migrations.js",
    "check:names": "node scripts/check-username-normalizer.js"
  },
  "license": "UNLICENSED"
}
